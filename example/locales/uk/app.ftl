# Текст, який бачить людина після входу
welcome-title = Ласкаво просимо
welcome-body = Відкрийте останню збірку { -brand-name } і продовжуйте роботу з того місця, де зупинилися.
-brand-name = Nightly
button-copy =
    .label = Запустити
    .tooltip = Відкрити найновішу збірку { -brand-name }
    .aria-label = Запустити { -brand-name }
install-hint =
    Скопіюйте посилання на завантаження для облікового запису { $gender ->
        [female] неї
        [male] нього
       *[other] них
    } на { $count ->
        [one] одному пристрої
       *[other] кількох пристроях
    } зараз.
# Основна дія на екрані завантажень
download-action =
    .label = Встановити збірку
    .accesskey = I
    .tooltip =
        Встановіть рекомендовану збірку для облікового запису { $gender ->
            [female] неї
            [male] нього
           *[other] них
        } на { $count ->
            [one] одному пристрої
           *[other] кількох пристроях
        } зараз.
sync-status =
    { $count ->
        [one] 1 завантаження готове.
       *[other] Кілька завантажень готові.
    }
secondary-copy = Більше тексту
